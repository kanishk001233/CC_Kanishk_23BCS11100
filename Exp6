#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;
    vector<string> a(n);
    for(int i = 0; i < n; i++) cin >> a[i];

    vector<vector<int>> adj(26);
    vector<int> indegree(26, 0);

    for(int i = 0; i < n - 1; i++) {
        string s = a[i], t = a[i + 1];
        int len = min(s.size(), t.size());
        bool found = false;

        for(int j = 0; j < len; j++) {
            if(s[j] != t[j]) {
                adj[s[j] - 'a'].push_back(t[j] - 'a');
                indegree[t[j] - 'a']++;
                found = true;
                break;
            }
        }

        if(!found && s.size() > t.size()) {
            cout << "Impossible";
            return 0;
        }
    }

    queue<int> q;
    for(int i = 0; i < 26; i++) {
        if(indegree[i] == 0) q.push(i);
    }

    string res = "";

    while(!q.empty()) {
        int u = q.front(); q.pop();
        res += char(u + 'a');

        for(auto v : adj[u]) {
            indegree[v]--;
            if(indegree[v] == 0) q.push(v);
        }
    }

    if(res.size() < 26) {
        cout << "Impossible";
    } else {
        cout << res;
    }

    return 0;
}
